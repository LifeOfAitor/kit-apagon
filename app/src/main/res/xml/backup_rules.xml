<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 8 to 11. Nothing is backed up (principle 8 in CLAUDE.md). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
